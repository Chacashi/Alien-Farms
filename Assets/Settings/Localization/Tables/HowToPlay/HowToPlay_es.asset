  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: HowToPlay_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 5abba3cebb7a32f42b8f7baae91d6072, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 348901376
    m_Localized: "Lleva animales de la zona central a tu corral. Cada animal vale
      distintos puntos (la vaca vale m\xE1s, pero pesa m\xE1s). Al acabar el tiempo
      gana quien tenga m\xE1s puntos en su corral. <color=#B04A0A>\xA1Ojo: el rival
      puede robarte, incluso desde tu corral!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 361484288
    m_Localized: "Cargando no puedes correr. Choca contra un rival que lleve un animal
      para rob\xE1rselo. Lanza la bomba para aturdir al rival."
    m_Metadata:
      m_Items: []
  - m_Id: 361484289
    m_Localized: "Teclado y rat\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 361484290
    m_Localized: "<color=#9A3E08>Mover:</color> WASD\n<color=#9A3E08>C\xE1mara:</color>
      Rat\xF3n\n<color=#9A3E08>Correr:</color> Shift izq.\n<color=#9A3E08>Agarrar:</color>
      mant\xE9n E (suelta para dejarlo)\n<color=#9A3E08>Apuntar:</color> mant\xE9n
      clic derecho\n<color=#9A3E08>Lanzar:</color> apuntando, suelta E\n<color=#9A3E08>Pausa:</color>
      mant\xE9n Esc 3 s\n<color=#9A3E08>Men\xFAs:</color> Enter confirmar, Esc volver"
    m_Metadata:
      m_Items: []
  - m_Id: 361484291
    m_Localized: Mando (PS / Xbox)
    m_Metadata:
      m_Items: []
  - m_Id: 361484292
    m_Localized: "<color=#9A3E08>Mover:</color> Stick izq.\n<color=#9A3E08>C\xE1mara:</color>
      Stick der.\n<color=#9A3E08>Correr:</color> L2 / LT\n<color=#9A3E08>Agarrar:</color>
      mant\xE9n R2 / RT (suelta para dejarlo)\n<color=#9A3E08>Apuntar:</color> mant\xE9n
      Cruz / A o L1 / LB\n<color=#9A3E08>Lanzar:</color> apuntando, suelta R2 / RT\n<color=#9A3E08>Pausa:</color>
      mant\xE9n Options / Menu 3 s\n<color=#9A3E08>Men\xFAs:</color> Cruz / A confirmar,
      C\xEDrculo / B volver"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
