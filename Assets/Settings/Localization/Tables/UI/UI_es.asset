    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120643
    m_Localized: "Unirse con c\xF3digo"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120644
    m_Localized: "Escribe el c\xF3digo de la sala (usa el teclado)"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120645
    m_Localized: Unirse
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120646
    m_Localized: "C\xF3digo de sala"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120647
    m_Localized: Empezar partida
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120648
    m_Localized: Salir de la sala
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120649
    m_Localized: "Esperando jugador\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120650
    m_Localized: "Esperando al anfitri\xF3n\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120651
    m_Localized: Elijan personaje
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120653
    m_Localized: "Sincronizando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120654
    m_Localized: "Anfitri\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120655
    m_Localized: "T\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120656
    m_Localized: "Conectando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120657
    m_Localized: "Creando sala\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120658
    m_Localized: "Uni\xE9ndose a la sala\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120659
    m_Localized: "Saliendo de la sala\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120660
    m_Localized: "Cargando partida\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120661
    m_Localized: Cancelar
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120662
    m_Localized: "Tus estad\xEDsticas"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120663
    m_Localized: Partidas
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120664
    m_Localized: Victorias
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120665
    m_Localized: Empates
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120666
    m_Localized: Derrotas
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120667
    m_Localized: Animales anotados
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120668
    m_Localized: Tackles conectados
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120669
    m_Localized: "Juega en l\xEDnea para guardar tus estad\xEDsticas"
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120670
    m_Localized: Guardado
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120671
    m_Localized: "No se pudo iniciar sesi\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120672
    m_Localized: "Los servicios en l\xEDnea no est\xE1n disponibles."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120673
    m_Localized: "Sin conexi\xF3n a internet."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120674
    m_Localized: Demasiados intentos. Espera un momento.
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120675
    m_Localized: "C\xF3digo no v\xE1lido."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120676
    m_Localized: "No existe una sala con ese c\xF3digo."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120677
    m_Localized: "La sala est\xE1 llena."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120678
    m_Localized: "Tu versi\xF3n del juego no coincide con la del anfitri\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120679
    m_Localized: "El anfitri\xF3n cerr\xF3 la sala."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120680
    m_Localized: "No se pudo establecer la conexi\xF3n (Relay)."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120681
    m_Localized: "Fall\xF3 la conexi\xF3n con la sala."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120682
    m_Localized: No se pudo unir a la sala.
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120683
    m_Localized: "Ya est\xE1s en una sala."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120684
    m_Localized: "Espera a que termine la operaci\xF3n actual."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120685
    m_Localized: "El modo en l\xEDnea no est\xE1 disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120686
    m_Localized: "Ocurri\xF3 un error inesperado."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120687
    m_Localized: Ese personaje ya fue elegido.
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120688
    m_Localized: "A\xFAn no tienes plaza en la sala."
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120689
    m_Localized: Faltan jugadores o personajes para empezar.
    m_Metadata:
      m_Items: []
  - m_Id: 3979076747120690
    m_Localized: No se pudo cargar la partida.
    m_Metadata:
      m_Items: []
  - m_Id: 4022579556503552
    m_Localized: "Ya est\xE1s conectado a esta sala desde otra ventana o dispositivo."
    m_Metadata:
      m_Items: []
  - m_Id: 4028777219477504
    m_Localized: "El anfitri\xF3n no pudo verificar que est\xE9s en esta sala."
    m_Metadata:
      m_Items: []
  - m_Id: 4174257857482752
    m_Localized: 'Esperando a {0}: {1} s'
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425792
    m_Localized: "{0} volvi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425793
    m_Localized: "{0} sali\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425794
    m_Localized: "{0} no volvi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425797
    m_Localized: Reconectar ({0} s)
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425798
    m_Localized: Tu nombre
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425799
    m_Localized: "Escribe tu nombre\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425800
    m_Localized: "Se perdi\xF3 la conexi\xF3n con la sala."
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425801
    m_Localized: No se pudo recuperar tu lugar en la sala.
    m_Metadata:
      m_Items: []
  - m_Id: 4174257899425802
    m_Localized: "Se acab\xF3 el tiempo para reconectar."
    m_Metadata:
      m_Items: []
  - m_Id: 4674187223093248
    m_Localized: "Guardando\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064768
    m_Localized: "No se pudo guardar (se reintentar\xE1)"
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064769
    m_Localized: "Rival: {0} partidas \xB7 {1} V \xB7 {2} E \xB7 {3} D"
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064770
    m_Localized: "El anfitri\xF3n abandon\xF3: victoria registrada"
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064771
    m_Localized: "{0} abandon\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064772
    m_Localized: "Sin conexi\xF3n: tus estad\xEDsticas se guardar\xE1n despu\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064773
    m_Localized: "Demasiadas solicitudes. Se reintentar\xE1 en un momento."
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064774
    m_Localized: "El guardado en la nube no est\xE1 disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064775
    m_Localized: "Inicia sesi\xF3n para guardar tus estad\xEDsticas."
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064776
    m_Localized: "Tus estad\xEDsticas son de una versi\xF3n m\xE1s nueva del juego."
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064777
    m_Localized: "Tus estad\xEDsticas en la nube no son v\xE1lidas."
    m_Metadata:
      m_Items: []
  - m_Id: 4674187244064778
    m_Localized: "No se pudieron cargar tus estad\xEDsticas."
    m_Metadata:
      m_Items: []
  - m_Id: 8344750428770304
    m_Localized: Local
    m_Metadata:
      m_Items: []
  - m_Id: 8871934184640512
    m_Localized: Sin voz
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360768
    m_Localized: En alcance
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360769
    m_Localized: Fuera de alcance
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360770
    m_Localized: No se pudieron obtener las credenciales de voz
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360771
    m_Localized: "No se pudo iniciar sesi\xF3n en el chat de voz"
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360772
    m_Localized: No se pudo entrar al canal de voz
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360773
    m_Localized: "Se perdi\xF3 la conexi\xF3n de voz"
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360774
    m_Localized: "Micr\xF3fono"
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360775
    m_Localized: Volumen del rival
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360776
    m_Localized: Silenciar rival
    m_Metadata:
      m_Items: []
  - m_Id: 8871934243360777
    m_Localized: Rival silenciado
    m_Metadata:
      m_Items: []
  - m_Id: 8979959297855488
    m_Localized: "La invitaci\xF3n ha caducado."
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827008
    m_Localized: No puedes agregarte a ti mismo
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827009
    m_Localized: Ya son amigos
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827010
    m_Localized: Ya hay una solicitud pendiente
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827011
    m_Localized: "La relaci\xF3n est\xE1 bloqueada"
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827012
    m_Localized: Este jugador no es tu amigo
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827013
    m_Localized: "Amigos no est\xE1 disponible"
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827014
    m_Localized: "Se perdi\xF3 la conexi\xF3n con Amigos"
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827015
    m_Localized: "No se pudo enviar la invitaci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 8979959318827016
    m_Localized: "Ocurri\xF3 un error en Amigos"
    m_Metadata:
      m_Items: []
